{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:full": "concurrently \"nodemon server.js\" \"npm run dev --prefix ../frontend\"",
    "test": "jest --setupFiles dotenv/config --runInBand",
    "test:coverage": "jest --coverage --setupFiles dotenv/config --runInBand"
  },

  "jest": {
    "verbose": true,
    "testEnvironment": "node",
    "collectCoverageFrom": [
        "controllers/**/*.js",
        "middlewares/**/*.js",
        "routes/**/*.js",
        "services/**/*.js"
    ]
  },

  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.1",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
